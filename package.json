{
  "name": "aicards",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "extension"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:extension": "npm --prefix extension run dev",
    "dev:all": "concurrently -n server,extension -c cyan,magenta \"npm:dev:server\" \"npm:dev:extension\"",
    "db:setup": "npm --prefix server run db:setup",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
